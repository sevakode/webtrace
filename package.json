{
  "name": "webtrace",
  "version": "1.0.1",
  "main": "index.ts",
  "dependencies": {
    "base64-js": "^1.5.1",
    "expo": "~57.0.22",
    "expo-file-system": "~57.0.7",
    "expo-sharing": "~57.0.19",
    "expo-status-bar": "~57.0.1",
    "fflate": "^0.8.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/base64-js": "^1.3.2",
    "@types/node": "^22.20.2",
    "@types/react": "~19.2.2",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "sh -c '. ./scripts/android-env.sh; expo run:android'",
    "ios": "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer expo run:ios",
    "web": "expo start --web",
    "recorder": "node scripts/build-recorder.mjs",
    "prestart": "npm run recorder",
    "pretest": "npm run recorder",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "preios": "npm run recorder",
    "preandroid": "npm run recorder",
    "fixture": "node scripts/fixture.mjs"
  },
  "private": true
